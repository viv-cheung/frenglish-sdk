{
    "name": "@frenglish/utils",
    "version": "1.0.64",
    "description": "Utils for Frenglish translation service",
    "type": "module",
    "main": "dist/index.js",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "browser": "dist/browser.js",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "browser": "./dist/browser.js",
            "types": "./dist/index.d.ts"
        },
        "./browser": {
            "import": "./dist/browser.js",
            "types": "./dist/browser.d.ts"
        }
    },
    "scripts": {
        "clean": "rm -rf dist",
        "build": "pnpm run clean && tsc",
        "prepare": "pnpm run build"
    },
    "keywords": [
        "utils",
        "frenglish"
    ],
    "author": "viv-cheung",
    "license": "MIT",
    "devDependencies": {
        "@types/crypto-js": "^4.2.2",
        "@types/jsdom": "^21.1.7",
        "@types/minimatch": "^5.1.2",
        "@types/node": "^22.20.1",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "chalk": "^5.6.2",
        "crypto-js": "^4.2.0",
        "dotenv": "^16.6.1",
        "glob": "^8.1.0",
        "glob-promise": "^6.0.7",
        "jsdom": "^24.1.3",
        "minimatch": "^10.2.6"
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    }
}
